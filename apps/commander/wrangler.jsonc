{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stavka-commander",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "durable_objects": {
    "bindings": [{ "name": "ORCHESTRATOR", "class_name": "OrchestratorAgent" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OrchestratorAgent"] }],
  "kv_namespaces": [{ "binding": "TERRAIN_CACHE", "id": "7b6659541b754b71bf36f7eaf2997065" }],
  "r2_buckets": [{ "binding": "SESSION_EXPORTS", "bucket_name": "stavka-session-exports" }],
  "vars": {
    "ENVIRONMENT": "production",
    "COMMANDER_MODEL": "stavka/commander",
    "SERGEANT_MODEL": "stavka/sergeant",
    "HEAVY_MODEL": "stavka/heavy",
    "DECISION_INTERVAL_SECONDS": "45",
    "DOCTRINE": "balanced",
    "MAX_ACTIVE_UNITS": "50",
    "DIFFICULTY": "0.5",
    "PLAYER_SCALING": "true",
    "TICK_INTERVAL_IDLE_MS": "2000",
    "TICK_INTERVAL_ACTIVE_MS": "750",
    "TICK_INTERVAL_BURST_MS": "300",
    "STAVKA_AI_PROVIDER": "openai",
    // Replaced after gateway deploy with the live workers.dev origin.
    "STAVKA_AI_BASE_URL": "https://stavka-maskirovka-gateway.andrii-shafar.workers.dev",
  },
  "observability": { "enabled": true },
}
