# Machine-wire bearer key. Use a generated sk-stavka-* value locally.
MASKIROVKA_SEAT_KEY=sk-stavka-replace-me

# Synthetic Cloudflare Access identity for exact local mode only. Hosted
# preview/production routes instead require a signed Access assertion.
DEV_ACCESS_EMAIL=developer@localhost
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
ACCESS_OWNER_SUBJECTS=
ACCESS_OPERATOR_SUBJECTS=

# Generate with: openssl rand -base64 32
STAVKA_PROVIDER_VAULT_KEY=

ENVIRONMENT=local
SEAT_ID=local-codex-seat
SEAT_PROVIDER=codex
MODEL_ALIASES={"stavka/sergeant":"gpt-5.6-luna","stavka/heavy":"gpt-5.6-terra"}
CONTAINER_SLEEP_AFTER=30s
