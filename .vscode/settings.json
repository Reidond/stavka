{
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "tailwindCSS.experimental.configFile": {
    "apps/stavka/src/styles.css": "apps/stavka/src/**",
    "apps/maskirovka-seat/src/dashboard/styles.css": "apps/maskirovka-seat/src/dashboard/**",
    "tools/maskirovka/src/dashboard/styles.css": "tools/maskirovka/src/dashboard/**",
    "services/inference/src/dashboard/styles.css": "services/inference/src/dashboard/**"
  },
  "tailwindCSS.classFunctions": [],
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "oxc.fmt.configPath": "./vite.config.ts",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  }
}
