# Machine-to-machine key used by local commander and Poligon.
API_KEY=sk-stavka-local-development-only

# Human surfaces use this synthetic identity only when ENVIRONMENT=local.
ENVIRONMENT=local
DEV_ACCESS_EMAIL=developer@localhost
ACCESS_TEAM_DOMAIN=https://example.cloudflareaccess.com
ACCESS_AUD=local-development

# Local AI traffic goes through Maskirovka; never put real provider keys here.
STAVKA_AI_BASE_URL=http://127.0.0.1:4141
STAVKA_AI_PROVIDER=openai
STAVKA_AI_KEY=maskirovka-local
COMMANDER_MODEL=stavka/commander
SERGEANT_MODEL=stavka/sergeant
HEAVY_MODEL=stavka/heavy
