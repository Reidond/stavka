# Local-only values. Never commit real provider credentials or gateway keys.
ENVIRONMENT=local
GATEWAY_ID=local-gateway
MASKIROVKA_GATEWAY_KEY=local-machine-key
DEV_ACCESS_EMAIL=operator@example.test
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
ACCESS_OWNER_SUBJECTS=
ACCESS_OPERATOR_SUBJECTS=
# Base64/base64url encoded 32-byte AES-GCM key for the local named-account vault.
STAVKA_PROVIDER_VAULT_KEY=
