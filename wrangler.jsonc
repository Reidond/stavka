{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warbench",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "warbench.sands.red", "custom_domain": true }],
  "vars": {
    "WAR_BENCH_ACCESS_AUD": "7d92471ccc10cf2755ed8c4cc0219ccc8a23b2d846eae909748c24ee9ee8cead",
    "WAR_BENCH_CODEX_BASE_URL": "https://gateway.ai.cloudflare.com/v1/3f5946e8e68fa04a86d36a5f83617f4b/warbench/custom-warbench-codex",
  },
  "durable_objects": {
    "bindings": [
      { "name": "AUTH_VAULT", "class_name": "AuthVault" },
      { "name": "BENCHMARK_STORE", "class_name": "BenchmarkStore" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AuthVault"] },
    { "tag": "v2", "new_sqlite_classes": ["BenchmarkStore"] },
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
  },
}
