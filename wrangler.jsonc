{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warbench",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "durable_objects": {
    "bindings": [
      { "name": "AUTH_VAULT", "class_name": "AuthVault" },
      { "name": "BENCHMARK_STORE", "class_name": "BenchmarkStore" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AuthVault"] },
    { "tag": "v2", "new_sqlite_classes": ["BenchmarkStore"] },
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
  },
}
