{
  "name": "@stavka/maskirovka",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "maskirovka": "./dist/cli.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "smoke": "tsx src/cli.ts smoke",
    "eval": "tsx src/cli.ts eval --replay",
    "test": "vitest run --config vitest.config.ts",
    "build:dashboard": "vp build --config vite.dashboard.config.ts",
    "build:cli": "tsc -p tsconfig.build.json",
    "build": "pnpm build:dashboard && pnpm build:cli",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@cloudflare/kumo": "2.9.2",
    "@effect/platform-node": "4.0.0-beta.102",
    "@phosphor-icons/react": "2.1.10",
    "@standard-schema/spec": "1.1.0",
    "@stavka/access-auth": "workspace:*",
    "@stavka/model-provider": "workspace:*",
    "@stavka/model-provider-claude": "workspace:*",
    "@stavka/model-provider-codex": "workspace:*",
    "@stavka/protocol": "workspace:*",
    "@stavka/provider-auth": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-form": "1.33.3",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-virtual": "3.14.9",
    "effect": "4.0.0-beta.102",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260801.1",
    "@types/node": "24.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "tailwindcss": "4.3.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.7",
    "vitest": "4.1.10"
  }
}
